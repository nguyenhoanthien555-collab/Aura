# Aura server environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way -
# it is the only file in the repository that is allowed to hold a secret.
#
#   cp .env.example .env
#
# Nothing here belongs in config.yaml. config.yaml is committed; this is not.

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------

# 127.0.0.1 refuses everything except this machine. Use 0.0.0.0 only once
# a token is set and you know what is in front of the port.
AURA_SERVER_HOST=127.0.0.1
AURA_SERVER_PORT=8000

# The bearer token every request must carry. Generate a real one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# REQUIRED. Leaving this empty no longer starts an unauthenticated
# server - startup fails with a configuration error instead, because a
# forgotten variable used to be enough to publish a public LLM.
AURA_SERVER_AUTH_TOKEN=

# Local development without a token, opted into deliberately. Only 1,
# true or yes count. Never set this on a deployed server: it makes every
# request pass authentication.
# AURA_ALLOW_INSECURE=1

# Comma-separated origins, or * for any. A phone app sends no Origin
# header, so `*` is not needed for Android - it is needed for a browser.
#
# With `*` the server does not send Access-Control-Allow-Credentials:
# that pairing let a preflight reflect any origin back with credentials
# enabled. Name your origins here to get credentialed CORS.
AURA_SERVER_CORS_ORIGINS=*

# Uvicorn's own HTTP log level. This does NOT change how much Aura
# itself logs - see AURA_LOG_LEVEL below.
AURA_SERVER_LOG_LEVEL=INFO

# Aura's application log level (the "Aura" logger: brain, providers,
# memory, tools). Read at import time, so it governs startup too, and it
# outranks `logging.level` in config.yaml. Set this - not the one above -
# when you are trying to diagnose Aura's behaviour on a deployment.
# AURA_LOG_LEVEL=DEBUG

# Request limits, in case the defaults do not suit your deployment.
# AURA_SERVER_MAX_MESSAGE_LENGTH=8000
# AURA_SERVER_MAX_SCREEN_TEXT_LENGTH=20000
# AURA_SERVER_MAX_UPLOAD_BYTES=8388608

# ----------------------------------------------------------------------
# LLM providers
# ----------------------------------------------------------------------
#
# These stay on the server. No client - Android, desktop or browser -
# ever receives one, and no response body or health payload contains one.
#
# Which of these are used, and in what order, is decided by config.yaml:
# `llm.provider` is the primary and `llm.fallback_providers` is the chain
# tried after it. A key set here for a provider that is not in that chain
# does nothing. A provider in the chain whose key is missing here is
# skipped, and the server says so by name at startup.

GEMINI_API_KEY=

# Fallback chain members. Both are supported providers with failover
# tests; they are in config.yaml's default chain, so leaving them blank
# means the chain silently shortens to whatever remains.
GROQ_API_KEY=
MISTRAL_API_KEY=

# Cloud fallback for both chat and screenshot vision. OpenRouter can be
# configured with a currently available free text and vision model in config.yaml.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Ollama needs no key, only a reachable host. Default http://127.0.0.1:11434.
# This is the machine the *server* runs on, which in a cloud deployment is
# not the user's PC - a hosted Ollama has to be reachable from there.
# OLLAMA_HOST=http://localhost:11434

# Model overrides, read only when config.yaml does not name one
# (`llm.groq_model`, `llm.mistral_model`). The defaults below are what
# the providers use if neither is set.
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=open-mistral-7b

# Endpoint overrides. Only needed for a proxy or a self-hosted
# compatible API; the providers default to the real endpoints.
# GROQ_BASE_URL=
# MISTRAL_BASE_URL=

# Not supported. There is no DeepSeek provider in this codebase, so
# DEEPSEEK_API_KEY is read by nothing and setting it has no effect
# (AURA-P2-004). Listed only so its presence in an existing .env is not
# mistaken for a configured fallback.

# Cerebras is present as brain/providers/cerebras.py but is deliberately
# not registered with the router - see that file's docstring. Setting
# CEREBRAS_API_KEY or CEREBRAS_BASE_URL has no effect either.

# ----------------------------------------------------------------------
# Voice (desktop only - the server synthesises nothing)
# ----------------------------------------------------------------------

# Nothing here. Voice is configured entirely in config.yaml under
# `voice.tts` / `voice.stt`, and no TTS or STT provider reads the
# environment. Edge TTS needs no key; the voice is `voice.tts.voice`.
#
# EDGE_TTS_VOICE and ELEVENLABS_API_KEY were listed here previously and
# were read by nothing - the latter belonged to the top-level `tts/`
# package removed in Phase 7.

# ----------------------------------------------------------------------
# Vision
# ----------------------------------------------------------------------

# Cloud vision is configured in config.yaml and uses GEMINI_API_KEY then
# OPENROUTER_API_KEY. No local model host is used in server mode.
