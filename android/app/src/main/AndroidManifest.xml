<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Runtime-requested on Android 13+, and only when the user turns
        companion notifications on in Settings.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        What `open_app` needs to exist at all.

        Since Android 11 (API 30) a package query is filtered to apps the
        manifest declares an interest in, and `getLaunchIntentForPackage`
        is a query: it resolves the target's MAIN/LAUNCHER activity.
        Without this block it returns null for every third-party app -
        including one whose package name is exactly right and which is
        installed - so `AuraActionExecutor`'s `open_app` branch returned
        false on every attempt and the agent loop spent all ten steps
        failing to launch an app that was sitting there the whole time.

        Declared as the MAIN/LAUNCHER intent rather than
        QUERY_ALL_PACKAGES. It is exactly the question `open_app` asks -
        "which apps can be launched" - it needs no policy declaration on
        Play, and it does not grant visibility of apps that have no
        launcher entry.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AuraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aura"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Aura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Screen observation.

            BIND_ACCESSIBILITY_SERVICE means only the system may bind this,
            so no other app can drive it. It does nothing until the user
            enables it in system settings *and* switches screen observation
            on inside Aura - the service checks the app-level toggle on
            every event, so the system-level grant alone sends nothing.
        -->
        <service
            android:name=".screen.ScreenObservationService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".accessibility.AuraAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_agent_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aura_accessibility_service" />
        </service>

    </application>

</manifest>
