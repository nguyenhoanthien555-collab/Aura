<?xml version="1.0" encoding="utf-8"?>
<!--
    What the screen observation service is allowed to see, and how often.

    `canRetrieveWindowContent` is what makes reading the accessibility tree
    possible at all. `notificationTimeout` is a floor Android enforces on
    event delivery - the app throttles far harder on top of it
    (ObservationThrottle), but setting it here means the events never even
    reach the process during a fast scroll.

    Note the absence of `canPerformGestures` and `canRequestFilterKeyEvents`.
    Aura reads; it does not act on your behalf and it does not see
    keystrokes.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="1000"
    android:settingsActivity="com.aura.companion.MainActivity" />
