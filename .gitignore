# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
# A 379 MB pre-upgrade virtualenv backup kept on disk. Untracked either
# way, but naming it here keeps `git status` and repo-wide greps clean.
.venv-py314-backup/

# Aura runtime data
data/*.db
data/*.db-journal
# Provider API keys, encrypted at rest (core/credentials.py), and the
# Control Hub's settings overlay (core/settings_store.py). Neither is
# source: both are written by the running server from the phone. The
# credential file is Fernet ciphertext, but a secret that is committed is
# a secret that is leaked whatever its encoding.
data/credentials.enc
data/credentials.enc.tmp
data/settings.json
data/settings.json.tmp
# The proactive send ledger (proactive/ledger.py). Not a secret, but it
# is a record of what Aura said to this owner unprompted, and it is
# written by the running server rather than by anyone editing the repo.
data/proactive.json
data/proactive.json.tmp
# The companion gate's own history, same file format and same reasoning
# (companion/policy.py). A separate file from the one above on purpose:
# one shared ledger would make each gate count the other's sends, and the
# owner configured two budgets, not one.
data/companion.json
data/companion.json.tmp
logs/
.aider*

# Android build output. All generated by Gradle - `./gradlew assemble`
# recreates every one of them. They were tracked (2147 files, ~90% of the
# repo), which made `git status` and any diff unreviewable.
# `android/gradle/wrapper/` is NOT here on purpose: the wrapper jar and
# properties are source, and a checkout without them cannot build.
android/.gradle/
android/app/build/
android/build/
android/.cxx/
*.class
*.dex
*.apk
*.aab
*.ap_

# Machine-specific: holds the local Android SDK path (and therefore a
# username). Every developer regenerates it; Android Studio writes it.
android/local.properties

# Artifacts of the SDK command-line tools install, not project source.
android/source.properties
android/NOTICE.txt

# Generated `tree` dump of the working copy (UTF-16, 11k lines).
aura-tree.txt

# A separate upstream clone that happens to live inside this working copy.
# It has its own .git, so tracking it here would nest two repositories.
awesome-claude-skills/

# Local Qwen coding-agent harness: only the sources (agent.py, prompts.py,
# config.yaml) are project files. The rest is machine state - its own
# virtualenv, bytecode, and a telemetry log that records what the agent
# thought about while reading this working copy.
local_agent/.venv/
local_agent/runtime/
local_agent/__pycache__/

# Device-agent capture logs (android/aura-agent*.log): transcripts of real
# accessibility sessions on this machine, not source.
# shot.png: screenshot tooling artifact. `da`: stray captured diff output.
android/.kotlin/
android/aura-agent*.log
shot.png
đa

# Codegraph's symbol index (438 MB on this machine). Regenerated by the
# indexing tool from the working copy; nothing reads it from a checkout.
.codegraph/

# Scratch space for live-verification captures and throwaway harnesses.
test_tmp/

# Root-level server capture logs. `logs/` is already ignored above; these
# two came from ad-hoc `python -m server.main > server_out.log` runs.
/server_out.log
/server_err.log

# Ad-hoc debugging scratch, same reasoning as shot.png.
_dbg_*.py

# Hand-captured device screenshots from companion verification sessions.
android/screen*.png
