# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
# A 379 MB pre-upgrade virtualenv backup kept on disk. Untracked either
# way, but naming it here keeps `git status` and repo-wide greps clean.
.venv-py314-backup/

# Aura runtime data
data/*.db
data/*.db-journal
# Provider API keys, encrypted at rest (core/credentials.py), and the
# Control Hub's settings overlay (core/settings_store.py). Neither is
# source: both are written by the running server from the phone. The
# credential file is Fernet ciphertext, but a secret that is committed is
# a secret that is leaked whatever its encoding.
data/credentials.enc
data/credentials.enc.tmp
data/settings.json
data/settings.json.tmp
logs/
.aider*

# Android build output. All generated by Gradle - `./gradlew assemble`
# recreates every one of them. They were tracked (2147 files, ~90% of the
# repo), which made `git status` and any diff unreviewable.
# `android/gradle/wrapper/` is NOT here on purpose: the wrapper jar and
# properties are source, and a checkout without them cannot build.
android/.gradle/
android/app/build/
android/build/
android/.cxx/
*.class
*.dex
*.apk
*.aab
*.ap_

# Machine-specific: holds the local Android SDK path (and therefore a
# username). Every developer regenerates it; Android Studio writes it.
android/local.properties

# Artifacts of the SDK command-line tools install, not project source.
android/source.properties
android/NOTICE.txt

# Generated `tree` dump of the working copy (UTF-16, 11k lines).
aura-tree.txt

# A separate upstream clone that happens to live inside this working copy.
# It has its own .git, so tracking it here would nest two repositories.
awesome-claude-skills/
